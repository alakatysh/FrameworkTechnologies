{
  "name": "labs",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "imports": {
    "#controllers/*": "./controllers/*",
    "#routes/*": "./routes/*",
    "#data/*": "./data/*",
    "#config/*": "./config/*",
    "#schemas/*": "./schemas/*",
    "#constants/*": "./constants/*"
  },
  "scripts": {
    "start": "node server.js",
    "predev": "npm run check",
    "dev": "nodemon server.js",
    "external": "json-server db.json --port 3001",
    "seed": "node src/scripts/seed.js",
    "migrate": "node src/migrations/migrate.js",
    "check": "npm run lint && npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,md,yml,yaml}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "json-server": "^1.0.0-beta.15",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "ajv": "^8.18.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0"
  }
}
